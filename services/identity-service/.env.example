# Copy this file to services/identity-service/.env and fill in real values.
# DB_USERNAME/DB_PASSWORD here MUST match IDENTITY_DB_USERNAME/
# IDENTITY_DB_PASSWORD in infrastructure/.env — same database, two configs.

DB_URL=jdbc:postgresql://localhost:5432/identity_db
DB_USERNAME=identity_service
DB_PASSWORD=changeme
SERVER_PORT=8081

OAUTH2_ISSUER_URI=http://localhost:8081
FRONTEND_REDIRECT_URI=http://localhost:5173/callback

# No safe default for either — generate real values, don't skip them.
PATIENT_SERVICE_CLIENT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
